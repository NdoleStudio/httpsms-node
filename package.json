{
	"name": "httpsms",
	"version": "0.0.4",
	"description": "Client for the httpSMS API",
	"license": "MIT",
	"repository": "https://github.com/NdoleStudio/httpsms-node",
	"funding": "https://github.com/sponsors/NdoleStudio",
	"author": "Arnold Ewin Acho <arnold@ndolestudio.com> (https://acho.arnold.cm)",
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "xo --env=node && npm run build && mocha -r ts-node/register \"tests/**/*.js\"",
		"build": "del-cli dist && tsc",
		"prepack": "npm run build"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"sms"
	],
	"dependencies": {
		"@types/node": "^26.0.1",
		"axios": "^1.6.5"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.0.1",
		"@types/chai": "^5.0.0",
		"@types/mocha": "^10.0.6",
		"chai": "^6.0.1",
		"del-cli": "^7.0.0",
		"mocha": "^12.0.2",
		"msw": "^3.0.3",
		"ts-node": "^10.9.2",
		"tsd": "^0.33.0",
		"xo": "^5.0.1"
	},
	"prettier": {
		"trailingComma": "all",
		"tabWidth": 4,
		"semi": true,
		"bracketSpacing": false,
		"arrowParens": "avoid",
		"singleQuote": true
	},
	"xo": [
		{
			"rules": {
				"n/file-extension-in-import": 0,
				"jsdoc/require-asterisk-prefix": 0,
				"unicorn/prefer-uint8array-base64": 0,
				"@typescript-eslint/no-unsafe-return": 0,
				"@typescript-eslint/no-unsafe-call": 0,
				"@typescript-eslint/no-unsafe-member-access": 0,
				"@typescript-eslint/no-unsafe-assignment": 0
			}
		},
		{
			"files": ["package.json"],
			"rules": {
				"package-json/prefer-exports": 0
			}
		}
	]
}
